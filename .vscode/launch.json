{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug go-grpc-client",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/go-grpc/go-grpc-client/main.go",
            "console": "integratedTerminal",  // 在 VS Code 的集成终端中显示程序输出
            "cwd": "${workspaceFolder}/go-grpc",
            "env": {}
        },
        {
            "name": "Debug go-grpc-server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/go-grpc/go-grpc-server/main.go",
            "console": "integratedTerminal",  // 在 VS Code 的集成终端中显示程序输出
            "cwd": "${workspaceFolder}/go-grpc",
            "env": {}
        }
    ]
}
